<Page x:Class="Attract.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#141218">
    <Grid>
        <Grid x:Name="BrowserHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Grid x:Name="StatusOverlay" Background="#141218" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <TextBlock x:Name="StatusTitle" Text="Attract" Foreground="#E6E0E9" FontSize="40" HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="" Foreground="#CAC4D0" FontSize="24" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="900" TextWrapping="Wrap" />
                <ProgressBar x:Name="StatusProgress" Width="480" Minimum="0" Maximum="100" Visibility="Collapsed" />
                <Button x:Name="RetryButton" Content="Try again" Click="RetryButton_Click" HorizontalAlignment="Center" MinWidth="200" FontSize="24" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
